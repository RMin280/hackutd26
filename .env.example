# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# Never commit .env or paste keys into code, logs or chat.

# --- LLM: primary + automatic backup -------------------------------------------------
# Every request goes to the primary first. If it's down, overloaded or not set up yet,
# the same request goes to the backup, which stays in use for LLM_FAILOVER_COOLDOWN s.
# Providers: openrouter (key: OPENROUTER_API_KEY), or openai_compatible (a Nemotron NIM
# or vLLM server on Brev, build.nvidia.com, or any other OpenAI-compatible server).

# Primary: our Nemotron on a Brev GPU machine. Once
#   brev port-forward <machine> --port 8000:8000      (in WSL Ubuntu on Windows)
# is running, the server answers at http://localhost:8000/v1.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
# The model name the server lists at http://localhost:8000/v1/models
AGENT_MODEL=

# Backup: NVIDIA Nemotron 3 Ultra (free) on OpenRouter.
BACKUP_LLM_PROVIDER=openrouter
BACKUP_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional OpenRouter-side fallbacks if Ultra itself is down (comma-separated).
AGENT_FALLBACK_MODELS=

# Seconds before a hanging primary counts as down, and how long to stay on the backup.
LLM_PRIMARY_TIMEOUT=60
LLM_FAILOVER_COOLDOWN=120

# Reasoning per agent step: none | minimal | low | medium | high
# (OpenRouter uses every level; on NIM/vLLM only "none" changes anything: thinking off)
AGENT_REASONING_EFFORT=low
AGENT_TEMPERATURE=0.6

# --- Squawk backend: SpacetimeDB (teammate's module) --------------------------
# Local server from `spacetime start` listens on 127.0.0.1:3000.
SPACETIME_HOST=http://127.0.0.1:3000
# Database name the module is published under (ask your teammate). Empty = skip.
SPACETIME_DB=
# Identity token for the agent (POST /v1/identity). Empty = anonymous.
# The fixer's own identity: `python -m agents.squawk_http setup` writes it here. Never commit or log it.
SPACETIME_TOKEN=
