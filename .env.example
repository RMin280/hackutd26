# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# Never commit .env or paste keys into code, logs or chat.

# --- LLM: three Nemotron tiers, tried in this order ------------------------------------
#   1. brev   our Nemotron on an NVIDIA Brev GPU machine (NIM or vLLM, port-forwarded)
#   2. super  NVIDIA Nemotron 3.5 Super (free) on OpenRouter
#   3. ultra  NVIDIA Nemotron 3 Ultra (free) on OpenRouter
# Every request goes to the first tier that's up. A tier that is down, overloaded, not set
# up or over a credit cap is skipped for LLM_FAILOVER_COOLDOWN s, and the same request goes
# to the next tier. When every tier fails, the agents fail closed and hand off to a person.

# Testing: true = only the free tiers (super, ultra). Brev is never contacted, so testing
# spends no Brev credits. Set it to false for the demo, once Brev is up and checked.
LLM_FREE_ONLY=true

# Tier 1, Brev. Once
#   brev port-forward <machine> --port 8000:8000      (in WSL Ubuntu on Windows)
# is running, the server answers at http://localhost:8000/v1. Any OpenAI-compatible
# Nemotron server works here (e.g. https://integrate.api.nvidia.com/v1 with a key).
BREV_BASE_URL=http://localhost:8000/v1
BREV_API_KEY=
# The model name the server lists at http://localhost:8000/v1/models
BREV_MODEL=

# Tiers 2 and 3, OpenRouter. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
SUPER_MODEL=nvidia/nemotron-3.5-super-vl:free
ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional OpenRouter-side fallbacks if both are down (comma-separated; may be paid
# models, so they're ignored while LLM_FREE_ONLY=true).
AGENT_FALLBACK_MODELS=

# Seconds before a hanging tier (any but the last) counts as down, and how long a failed
# tier is skipped before it's tried again.
LLM_TIER_TIMEOUT=60
LLM_FAILOVER_COOLDOWN=120

# Reasoning per agent step: none | minimal | low | medium | high
# (OpenRouter uses every level; on NIM/vLLM only "none" changes anything: thinking off)
AGENT_REASONING_EFFORT=low
AGENT_TEMPERATURE=0.6

# --- Credit caps (agents/budget.py) ----------------------------------------------------
# Checked before every request to a metered endpoint (free :free models and our own Brev
# server cost nothing per token; Brev bills its GPU hours, which this can't see). Past a
# cap, the router moves on to a free tier, or the agents fail closed and hand off to a person.
# Spending is kept in .agent_usage.json (gitignored), shared by every agent process here.
AGENT_BUDGET_USD=20
AGENT_DAILY_BUDGET_USD=5
AGENT_DAILY_REQUESTS=600
# USD per million tokens, used when the provider doesn't report the cost (errs high).
MODEL_PRICE_IN_PER_M=0.10
MODEL_PRICE_OUT_PER_M=0.50

# --- Squawk backend: SpacetimeDB (teammate's module) --------------------------
# Local server from `spacetime start` listens on 127.0.0.1:3000.
SPACETIME_HOST=http://127.0.0.1:3000
# Database name the module is published under (ask your teammate). Empty = skip.
SPACETIME_DB=
# Identity token for the agent (POST /v1/identity). Empty = anonymous.
# The fixer's own identity: `python -m agents.squawk_http setup` writes it here. Never commit or log it.
SPACETIME_TOKEN=
# The update agent's own identity: `python -m agents.squawk_http setup --agent update`.
SPACETIME_UPDATE_TOKEN=
# An external agent behind the MCP server (python -m agents.mcp_server):
# `python -m agents.squawk_http setup --agent mcp [--role technician]` (default role: viewer, read only).
SPACETIME_MCP_TOKEN=
SPACETIME_MCP_ACTOR=mcp-agent

# --- Update agent (agents/patch) ---------------------------------------------------
# Free healthy spares a rollout never dips below, so a failed job can always restart.
PATCH_SPARE_RESERVE=40
